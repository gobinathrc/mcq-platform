# MCQ Assessment Platform (.env.example)

# Port for backend
PORT=5000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# JWT Secret for candidate authentication
JWT_SECRET=replace_with_a_super_strong_random_secret_string

# PostgreSQL connection string (Provided directly by Render / Neon / Supabase / Local PostgreSQL)
# Example Render URL: postgres://mcq_admin:password@dpg-xxxxx-a.oregon-postgres.render.com/mcq_exam_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mcq_db

# Connection Pool size for 70+ concurrent test takers
DB_POOL_MAX=50
